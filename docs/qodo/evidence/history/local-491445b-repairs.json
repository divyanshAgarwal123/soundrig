{"findings":[{"id":"2f89f26e-1d8f-4c26-8e9c-8b478746c981","title":"Native integration can pass without SoundRig","description":"`is_control()` does not classify the native test fixture's `game.gd` as a verification control, although the tested scene loads it to create and connect SoundRig. An owner-authored PR can replace that integration with a stub satisfying the test's counter assertions, receive a passing native receipt, and avoid the human-review blocker for control changes.","category":"Correctness","action_level":"remediation_recommended","attribution_status":"implemented","git_sha":"568298a0e3c88a20edaf9160ecacf29600d47375","location":{"file_path":"ci/review_gate.py","start_line":115,"end_line":117,"side":"right"},"evidence":{"citations":[{"source_type":"pr_branch_file","source":"ci/review_gate.py[33-37]"},{"source_type":"pr_branch_file","source":"ci/review_gate.py[114-126]"},{"source_type":"pr_branch_file","source":".github/workflows/ci.yml[54-64]"},{"source_type":"pr_branch_file","source":"integration-proof/godot-platformer/game_singleplayer.tscn[3-8]"},{"source_type":"pr_branch_file","source":"integration-proof/godot-platformer/game.gd[21-35]"},{"source_type":"pr_branch_file","source":"integration-proof/godot-platformer/test_soundrig_integration.gd[8-29]"},{"source_type":"pr_branch_file","source":"ci/native_receipt.py[10-22]"}]}}],"finding_state":{"complete":true,"introduced":[],"resolved":["2f89f26e-1d8f-4c26-8e9c-8b478746c981"],"still_open":[],"dismissed":[]},"review_agent_comment":"Nothing to comment.","meta":{"analysis":{"baseline_checkpoint_id":"cd4841fea0e545f59b42d957479738e9","mode":"incremental","reason":"changes_since_checkpoint"},"checkpoint":{"base_sha":"568298a0e3c88a20edaf9160ecacf29600d47375","coverage_started_at":"2026-11-16T15:18:42.889805+00:00","created_at":"2026-11-16T15:28:48.976823+00:00","id":"c28c83f6f0904d4cbcf7de8789a3361b","sequence":32814,"tree_sha":"73db8d577153c77426de09a2e8325be4b7a96226","version":1},"context":{"author_note