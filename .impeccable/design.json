  "narrative": {
    "northStar": "Soundcheck pressing room",
    "overview": "SoundRig borrows the physical confidence of a test-pressing sleeve: warm paper, orange ink, oversized lettering and a dimensional record. The typography and working audio comparison carry the identity. The artwork supplies atmosphere while native controls carry every action.\n\nThe landing page is expansive, the studio is dense enough for repeated work, and the guide is paced for reading. They share the same paper, ink, display face, restrained curves and thin separators.",
    "keyCharacteristics": [
      "Warm neutral paper with a subdued raster grain.",
      "Rounded-dot display lettering paired with clear sans-serif controls.",
      "Orange actions, sage comparison states and factual audio feedback.",
      "Flat working surfaces separated by rules.",
      "Listening controls before artwork on phones and tablets."
    ],
    "rules": [
      {
        "name": "The Paper Rule",
        "body": "Keep paper neutral and legible beneath the texture. The shipped surface places a translucent paper-colored layer over the raster grain; the grain must not become a yellow cast.",
        "section": "colors"
      },
      {
        "name": "The Sleeve Type Rule",
        "body": "Use SoundRig Display for identity and headings; keep control labels, explanations and operational state in DM Sans. Portable hosts retain the local display face for their title and use a system sans-serif body.",
        "section": "typography"
      },
      {
        "name": "The Controls First Rule",
        "body": "On phones and tablets, keep audio comparison and the studio action before the record artwork.",
        "section": "layout"
      },
      {
        "name": "The Flat Workbench Rule",
        "body": "Keep controls and working sections on the paper plane. Use thin separators and quiet fills to express grouping.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep warm paper, printing ink and orange as the shared visual foundation.",
      "**Do** retain the local SoundRig Display font and its rounded punctuation in site and portable titles.",
      "**Do** put audio controls before record artwork on phones and tablets.",
      "**Do** use native controls, explicit focus and factual playback or validation state.",
      "**Do** separate working sections with rules, space and quiet fills.",
      "**Do** preserve readable text measures and wrap long code or source notes."
    ],
    "donts": [
      "**Don't** turn the subdued paper grain into a strong yellow surface.",
      "**Don't** replace working interface text with raster artwork.",
      "**Don't** use the record's dimensional lighting as a reason to add shadows to controls or working panels.",
      "**Don't** use display lettering for dense operational text.",
      "**Don't** imply music generation, listening preference or product validation through the imagery or interface."
    ]
  }
}
